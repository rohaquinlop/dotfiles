#!/usr/bin/env bash
# Keeps the login screen and the lock screen on the same wallpaper and palette.
#
# Both screens need the wallpaper as a pre-rendered image, because neither the
# SDDM greeter (the home directory is mode 700) nor Noctalia's lock screen can
# take it from the live desktop:
#
#   /usr/share/sddm/themes/cachyos/background.jpg        greeter, mark drawn on top by QML
#   /usr/share/sddm/themes/cachyos/NoctaliaColors.qml    greeter colours, read by Main.qml
#   <home>/.local/state/noctalia/lock-background.jpg      lock screen, mark baked in
#
# It runs as root from sddm-theme-sync.path, which watches Noctalia's
# settings.toml, so switching the wallpaper or the palette updates both screens
# with no manual step. The greeter colours come from the gtk3 template's output
# (noctalia.css), which names primary/surface/on_surface/error for the active
# palette. Run it by hand after changing it:
#
#   sudo sddm-theme-sync
#
# Validate the chain without changing anything (read-only, no root needed).
# It reports the active palette, then checks that the greeter palette and both
# backgrounds follow it. Exit status 0 means the lock screen and the login
# screen carry the selected theme:
#
#   sddm-theme-sync --check
#
# Overrides (used by the tests, and handy on another machine):
#   TARGET_HOME  user whose Noctalia state and home directory to use
#   THEME_DIR    where to write the greeter background and palette
#   STATE_DIR    where to write the lock screen background
#   SCRIM        darkening over the wallpaper, default 55%
set -euo pipefail

check=false
[ "${1:-}" = "--check" ] && check=true

target_home="${TARGET_HOME:-/home/rohaquinlop}"
theme_dir="${THEME_DIR:-/usr/share/sddm/themes/cachyos}"
state_dir="${STATE_DIR:-$target_home/.local/state/noctalia}"
scrim="${SCRIM:-55}"

settings="$target_home/.local/state/noctalia/settings.toml"
lock_bg="$state_dir/lock-background.jpg"
greeter_bg="$theme_dir/background.jpg"
wordmark="$theme_dir/wordmark.png"
stamp="$state_dir/.sddm-theme-sync.stamp"

# Vertical offset of the baked mark from the image centre, at the 1920x1200
# design size (see the composite below). It is part of the stamp, so changing it
# here forces one rebuild of both backgrounds.
mark_offset="-33"

[ -f "$settings" ] || { echo "no Noctalia settings at $settings" >&2; exit 1; }

# Wallpaper: the persisted default, else whatever Noctalia is showing now.
wallpaper="$(sed -n 's/^\[wallpaper\.default\]$//; t; /^path = / { s/^path = "\(.*\)"$/\1/p; q }' "$settings")"
if [ ! -f "$wallpaper" ]; then
  wallpaper="$(sed -n '/^\[wallpaper\.last\]/,/^\[/ s/^path = "\(.*\)"$/\1/p' "$settings" | head -1)"
fi
[ -f "$wallpaper" ] || { echo "wallpaper not found (settings say: ${wallpaper:-nothing})" >&2; exit 1; }

# Palette. noctalia.css is the gtk3 template's output for the active palette and
# is rewritten whenever that palette changes, so the greeter can read the two
# screens' colours from there without talking to Noctalia. The Akane values below
# are the fallback baked into the theme's own NoctaliaColors.qml, which is what
# `sddm-greeter-qt6 --test-mode` renders in the repo.
palette_css="$target_home/.config/gtk-3.0/noctalia.css"
colors_qml="$theme_dir/NoctaliaColors.qml"
bg_color="#12101c"
accent_color="#e15a48"
text_color="#f0c4a8"
danger_color="#d6453d"

if [ -r "$palette_css" ]; then
  # Noctalia persists the palette to settings.toml (this unit's trigger) and only
  # writes noctalia.css about a tenth of a second later, so wait briefly for the
  # CSS to catch up: reading the old file would put the greeter one palette
  # change behind, and the stamp would then hide the lag. The check mode does
  # not wait: it is read-only and must not slow down.
  if [ "$check" != true ] && [ "$palette_css" -ot "$settings" ]; then
    for _ in $(seq 1 20); do
      sleep 0.25
      [ "$palette_css" -nt "$settings" ] && break
    done
  fi

  css_color() {
    sed -n "s/^@define-color $1 \(#[0-9a-fA-F]\{6\}\);.*$/\1/p" "$palette_css" | head -1
  }
  value="$(css_color window_bg_color || true)"
  [ -n "$value" ] && bg_color="$value"
  value="$(css_color accent_color || true)"
  [ -n "$value" ] && accent_color="$value"
  value="$(css_color window_fg_color || true)"
  [ -n "$value" ] && text_color="$value"
  value="$(css_color destructive_bg_color || true)"
  [ -n "$value" ] && danger_color="$value"
fi

# Nothing to do when both outputs are already built from this wallpaper and
# palette. The palette is part of the stamp, so colours change without a new
# wallpaper still rebuild the scrimmed backgrounds.
source_stamp="$(stat -c '%n %Y %s' "$wallpaper") bg=$bg_color scrim=$scrim mark=$mark_offset"

# Read-only validation of the chain: the greeter palette must carry the active
# palette's four colours, and both backgrounds must be built from the current
# wallpaper and palette. For a custom palette the four colours are also checked
# against the palette file itself. The lock screen widgets read the live palette
# at render time, so a passing chain means the lock screen shows the theme.
if [ "$check" = true ]; then
  fail=0

  theme_field() {
    awk -F' = ' -v key="$1" '
      /^\[theme\]$/ { in_theme = 1; next }
      /^\[/ { in_theme = 0 }
      in_theme && $1 == key { gsub(/"/, "", $2); print $2; exit }
    ' "$settings"
  }
  qml_color() {
    sed -n "s/.*property color $1: \"\(#[0-9a-fA-F]\{6\}\)\".*$/\1/p" "$colors_qml" | head -1
  }

  theme_source="$(theme_field source)"
  case "$theme_source" in
    custom)    theme_name="$(theme_field custom_palette)" ;;
    builtin)   theme_name="$(theme_field builtin)" ;;
    community) theme_name="$(theme_field community_palette)" ;;
    wallpaper) theme_name="$(theme_field wallpaper_scheme)" ;;
    *)         theme_name="" ;;
  esac
  echo "theme: ${theme_source:-unknown}${theme_name:+ $theme_name}"
  echo "palette: bg $bg_color, accent $accent_color, text $text_color, danger $danger_color"

  # A custom palette is a plain JSON file, so its four colours can be checked
  # against noctalia.css. A built-in or wallpaper palette is resolved inside
  # Noctalia and has no file to compare: the CSS is the reference there.
  if [ "$theme_source" = "custom" ]; then
    palette_json="$target_home/.config/noctalia/palettes/${theme_name}.json"
    if [ ! -f "$palette_json" ]; then
      echo "FAIL: no palette file at $palette_json"
      fail=1
    else
      json_color() {
        sed -n "s/.*\"$1\": \"\(#[0-9a-fA-F]\{6\}\)\".*$/\1/p" "$palette_json" | head -1
      }
      for pair in "mSurface:$bg_color" "mPrimary:$accent_color" \
                  "mOnSurface:$text_color" "mError:$danger_color"; do
        name="${pair%%:*}"
        want="${pair#*:}"
        got="$(json_color "$name")"
        if [ "$got" = "$want" ]; then
          echo "ok: noctalia.css $name $got"
        else
          echo "FAIL: noctalia.css $name is ${got:-missing}, expected $want (run: noctalia msg templates-apply)"
          fail=1
        fi
      done
    fi
  else
    echo "note: $theme_source palette has no file to compare; noctalia.css is the reference"
  fi

  if [ ! -f "$colors_qml" ]; then
    echo "FAIL: no greeter palette at $colors_qml (run: sudo sddm-theme-sync)"
    fail=1
  else
    for pair in "bgColor:$bg_color" "accentColor:$accent_color" \
                "textColor:$text_color" "dangerColor:$danger_color"; do
      name="${pair%%:*}"
      want="${pair#*:}"
      got="$(qml_color "$name")"
      if [ "$got" = "$want" ]; then
        echo "ok: greeter palette $name $got"
      else
        echo "FAIL: greeter palette $name is ${got:-missing}, expected $want (run: sudo sddm-theme-sync)"
        fail=1
      fi
    done
  fi

  if [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$source_stamp" ] &&
     [ -f "$greeter_bg" ] && [ -f "$lock_bg" ]; then
    echo "ok: backgrounds are built from the current wallpaper and palette"
  else
    echo "FAIL: backgrounds are stale (run: sudo sddm-theme-sync)"
    fail=1
  fi

  [ "$fail" = 0 ] && echo "lock screen and login screen follow the active theme"
  exit "$fail"
fi

command -v magick >/dev/null || { echo "imagemagick is required" >&2; exit 1; }

mkdir -p "$theme_dir" "$state_dir"

# Only rewrite the greeter colours when they actually change: the greeter reads
# the file at startup, and an unchanged file keeps the next sync quiet.
write_greeter_palette() {
  local tmp
  tmp="$(mktemp "$theme_dir/.NoctaliaColors.qml.XXXXXX")"
  cat >"$tmp" <<EOF
// Generated by /usr/local/bin/sddm-theme-sync from Noctalia's active palette.
// Do not edit: the next palette or wallpaper change overwrites this file. The
// repo copy of this file holds the Akane fallback for a machine with no
// Noctalia, and for the greeter's --test-mode preview.
import QtQuick 2.0

QtObject {
    property color bgColor: "$bg_color"      // surface
    property color accentColor: "$accent_color"  // primary
    property color textColor: "$text_color"    // on_surface
    property color dangerColor: "$danger_color"  // error
}
EOF
  if [ -f "$colors_qml" ] && cmp -s "$colors_qml" "$tmp"; then
    rm -f "$tmp"
    return 0
  fi
  chmod a+r "$tmp" # mktemp is 0600; the greeter runs as the sddm user
  mv "$tmp" "$colors_qml"
  echo "greeter palette: bg $bg_color, accent $accent_color, text $text_color, danger $danger_color"
}

if [ -r "$palette_css" ] || [ ! -f "$colors_qml" ]; then
  write_greeter_palette
fi

if [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$source_stamp" ] &&
   [ -f "$greeter_bg" ] && [ -f "$lock_bg" ]; then
  exit 0
fi

# 1920x1200 is this panel; QML crops rather than stretches, so other sizes are safe.
magick "$wallpaper" -resize 1920x1200^ -gravity center -extent 1920x1200 \
  -fill "$bg_color" -colorize "$scrim" -quality 90 -strip "$greeter_bg"

if [ -f "$wordmark" ]; then
  # The greeter draws the mark inside a centred column (mark, 26px gap, input
  # row at the 1920x1200 design size), so its mark centre sits at y 567, not at
  # the image centre. Bake the mark at the same spot: the lock screen widgets
  # can then use the greeter's own row position and both screens line up.
  magick "$greeter_bg" "$wordmark" -gravity center -geometry "+0$mark_offset" \
    -composite -quality 90 -strip "$lock_bg"
else
  cp "$greeter_bg" "$lock_bg" # mark missing: still keep the wallpaper in sync
fi

# The lock background lives in the user's state directory, so hand it back.
if [ "$(id -u)" = 0 ] && [ -n "${SUDO_UID:-}" ]; then
  chown "${SUDO_UID}:${SUDO_GID:-$SUDO_UID}" "$lock_bg" 2>/dev/null || true
elif [ "$(id -u)" = 0 ]; then
  owner="$(stat -c '%u:%g' "$settings")"
  chown "$owner" "$lock_bg" 2>/dev/null || true
fi

printf '%s\n' "$source_stamp" > "$stamp"
[ "$(id -u)" = 0 ] && chown "$(stat -c '%u:%g' "$settings")" "$stamp" 2>/dev/null || true

echo "synced: $wallpaper -> $greeter_bg, $lock_bg"
