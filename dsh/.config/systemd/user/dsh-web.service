[Unit]
Description=DeepSeek Harness web UI
Documentation=https://github.com/deepseek-ai/dsh
# The harness is installed outside this repo; skip the unit until it exists.
ConditionPathExists=%h/.local/share/dsh/node_modules/.bin/dsh
After=network.target

[Service]
Type=simple
WorkingDirectory=%h
Environment=PATH=/usr/share/omarchy/bin:%h/.local/share/mise/shims:/usr/local/sbin:/usr/local/bin:/usr/bin:%h/.local/bin:/usr/bin/site_perl:/usr/bin/vendor_perl:/usr/bin/core_perl
ExecStart=%h/.local/bin/dsh-run
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
