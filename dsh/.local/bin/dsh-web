#!/bin/sh
# Open the DeepSeek Harness web UI.
#
# The UI is served by dsh-web.service. If the service is stopped, start it and
# wait for the port. A profile patch edit needs a restart, because the running
# server keeps the configuration it booted with, so restart first when the
# profile changed after the service started. The server requires a per-run
# token and prints the authenticated URL to its journal, so open that URL
# instead of the bare address. A browser that still holds a trust cookie also
# works, but the token URL covers a fresh browser profile.
set -u

base="http://127.0.0.1:3080/"

is_up() {
  curl -s -o /dev/null --max-time 1 "$base" 2>/dev/null
}

# An open app holds an established connection to the port. Restarting under it
# kills the session, so only restart a stale server when no window is attached.
clients_connected() {
  [ -n "$(ss -Htn state established "( sport = :3080 )" 2>/dev/null)" ]
}

if "$HOME/.local/bin/dsh-config-stale" >/dev/null 2>&1 && ! clients_connected; then
  systemctl --user restart dsh-web.service >/dev/null 2>&1 || true
fi

if ! is_up; then
  systemctl --user start dsh-web.service >/dev/null 2>&1 || true

  i=0
  while [ "$i" -lt 40 ]; do
    is_up && break
    sleep 0.5
    i=$((i + 1))
  done
fi

url=$(journalctl --user -u dsh-web.service -b -o cat --no-pager 2>/dev/null \
  | grep -oE 'http://127\.0\.0\.1:3080/\?token=[A-Za-z0-9_-]+' | tail -1)

exec /usr/share/omarchy/bin/omarchy-launch-webapp "${url:-$base}"
